# ---------------------------------------------------------------
# SkillSwap Campus configuration. Copy this file to .env.local
# (git-ignored) and adjust. NEVER commit real credentials.
# ---------------------------------------------------------------

# PostgreSQL 14+ with the pgvector extension.
# Default matches docker-compose.yml (Docker maps Postgres to port 5433).
# Native install example: postgres://postgres:<your-password>@localhost:5432/skillswap_campus
# Neon example:          postgres://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://skillswap:skillswap@localhost:5433/skillswap_campus

# Secret used to sign login session tokens (any long random string).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Campus time zone (session times are stored in local time)
APP_TIMEZONE=Asia/Kolkata
